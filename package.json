{
  "name": "test-automation-app",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation for Web UI and API testing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx app/src/server.ts",
    "dev": "tsx watch app/src/server.ts",
    "test": "playwright test --project=web-chromium --project=api",
    "test:web": "playwright test --project=web-chromium",
    "test:api": "playwright test --project=api",
    "test:bugs": "playwright test --project=bug-hunting-api --project=bug-hunting-web",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:file": "playwright test",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "node scripts/allure-generate.mjs",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "allure"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.47.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
